{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "frontend": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "architect": {
        "build": {
          "builder": "@angular-builders/custom-webpack:browser",
          "options": {
            "customWebpackConfig": {
              "path": "./custom-webpack.config.mjs"
            },
            "allowedCommonJsDependencies": [
              "geolib",
              "rfdc",
              "fast-deep-equal"
            ],
            "budgets": [
              {
                "type": "anyComponentStyle",
                "maximumWarning": "64kb"
              }
            ],
            "outputPath": "dist/frontend/browser",
            "index": "src/index.html",
            "main": "src/main.ts",
            "tsConfig": "src/tsconfig.app.json",
            "polyfills": "src/polyfills.ts",
            "preserveSymlinks": true,
            "assets": [
              "src/assets",
              "src/assets/icon.svg"
            ],
            "styles": [
              "src/styles.scss"
            ],
            "scripts": [
              {
                "input": "src/assets/js/gtag.js",
                "inject": false,
                "bundleName": "google-module"
              }
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "src"
              ]
            },
            "aot": false,
            "extractLicenses": false,
            "buildOptimizer": false,
            "sourceMap": true,
            "optimization": {
              "scripts": false,
              "styles": false,
              "fonts": false
            },
            "namedChunks": true
          },
          "configurations": {
            "production": {
              "aot": true,
              "optimization": {
                "scripts": true,
                "styles": true,
                "fonts": true
              },
              "outputHashing": "all",
              "sourceMap": true,
              "namedChunks": false,
              "buildOptimizer": true,
              "extractLicenses": true
            },
            "staging": {
              "optimization": true,
              "outputHashing": "all",
              "namedChunks": false,
              "extractLicenses": true
            },
            "dev": {
              "optimization": false,
              "outputHashing": "all",
              "sourceMap": true,
              "namedChunks": false,
              "extractLicenses": true
            },
            "ci": {
              "extractLicenses": false,
              "buildOptimizer": false,
              "sourceMap": true,
              "optimization": false,
              "namedChunks": true
            },
            "docker": {
              "optimization": true,
              "outputHashing": "all",
              "namedChunks": false,
              "extractLicenses": true
            }
          },
          "defaultConfiguration": ""
        },
        "serve": {
          "builder": "@angular-builders/custom-webpack:dev-server",
          "options": {
            "buildTarget": "frontend:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "frontend:build:production"
            },
            "staging": {
              "buildTarget": "frontend:build:staging"
            },
            "dev": {
              "buildTarget": "frontend:build:dev"
            },
            "ci": {
              "buildTarget": "frontend:build:ci"
            },
            "docker": {
              "buildTarget": "frontend:build:docker"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "frontend:build"
          }
        },
        "test": {
          "builder": "@angular-builders/jest:run",
          "options": {
            "detectOpenHandles": true,
            "forceExit": true,
            "tsConfig": "tsconfig.spec.json",
            "configPath": "jest.config.mjs"
          }
        },
        "e2e": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "frontend:serve",
            "watch": true,
            "headless": false
          },
          "configurations": {
            "production": {
              "devServerTarget": "frontend:serve:production"
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html",
              "cypress/**/*.ts"
            ]
          }
        },
        "cypress-run": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "frontend:serve"
          },
          "configurations": {
            "production": {
              "devServerTarget": "frontend:serve:production"
            }
          }
        },
        "cypress-open": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "watch": true,
            "headless": false
          }
        },
        "server": {
          "builder": "@angular-devkit/build-angular:server",
          "options": {
            "outputPath": "dist/frontend/server",
            "main": "src/server.ts",
            "tsConfig": "src/tsconfig.server.json",
            "buildOptimizer": false,
            "optimization": true,
            "sourceMap": true,
            "stylePreprocessorOptions": {
              "includePaths": [
                "src"
              ]
            },
            "preserveSymlinks": true,
            "extractLicenses": false
          },
          "configurations": {
            "production": {
              "buildOptimizer": true,
              "outputHashing": "media",
              "optimization": true,
              "sourceMap": true,
              "extractLicenses": true
            },
            "staging": {
              "outputHashing": "media",
              "optimization": true,
              "extractLicenses": true
            },
            "dev": {
              "outputHashing": "media",
              "optimization": false,
              "sourceMap": true,
              "extractLicenses": true
            },
            "ci": {
              "buildOptimizer": false,
              "optimization": false,
              "sourceMap": true,
              "extractLicenses": false
            },
            "docker": {
              "outputHashing": "media",
              "optimization": true,
              "extractLicenses": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve-ssr": {
          "builder": "@angular-devkit/build-angular:ssr-dev-server",
          "configurations": {
            "development": {
              "browserTarget": "frontend:build:development",
              "serverTarget": "frontend:server:development"
            },
            "production": {
              "browserTarget": "frontend:build:production",
              "serverTarget": "frontend:server:production"
            }
          },
          "defaultConfiguration": "development"
        },
        "prerender": {
          "builder": "@angular-devkit/build-angular:prerender",
          "options": {
            "routes": [
              "/"
            ]
          },
          "configurations": {
            "production": {
              "browserTarget": "frontend:build:production",
              "serverTarget": "frontend:server:production"
            },
            "development": {
              "browserTarget": "frontend:build:development",
              "serverTarget": "frontend:server:development"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "prefix": "app",
      "style": "scss"
    },
    "@schematics/angular:directive": {
      "prefix": "app"
    }
  },
  "cli": {
    "schematicCollections": [
      "@angular-eslint/schematics"
    ],
    "cache": {
      "enabled": false
    },
    "analytics": false
  }
}

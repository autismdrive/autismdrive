{
  "name": "autismdrive",
  "version": "1.18.0",
  "scripts": {
    "backend-reset": "cd .. && ./reset-backend.sh --skip_update && cd ..",
    "build": "ng build",
    "bundle-report": "webpack-bundle-analyzer dist/star-drive/stats-es5.json",
    "cypress:ci": "cypress run --headless --browser chrome --config viewportWidth=1440,viewportHeight=900",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "e2e": "ng e2e",
    "format": "prettier --write .",
    "lint": "tsc --noEmit && eslint eslint.config.mjs",
    "lint-and-fix": "tsc --noEmit && eslint eslint.config.mjs --fix",
    "ng": "ng",
    "start": "ng serve",
    "start_production": "ng serve --configuration=production",
    "start_staging": "ng serve --configuration=staging",
    "start_dev": "ng serve --configuration=dev",
    "start_ci": "ng serve --configuration=ci",
    "start_proxy": "ng serve --port 4200 --host proxy.debug --configuration=proxy",
    "start_ssl": "ng serve --ssl true",
    "test": "ng test frontend",
    "test:watch": "jest -o --watch --config ./jest.config.mjs",
    "test_headless": "jest --coverage --config ./jest.config.mjs"
  },
  "engines": {
    "node": "22"
  },
  "private": true,
  "dependencies": {
    "@angular-eslint/schematics": "19.0.2",
    "@angular/animations": "19.1.1",
    "@angular/cdk": "19.1.0",
    "@angular/common": "19.1.1",
    "@angular/compiler": "19.1.1",
    "@angular/core": "19.1.1",
    "@angular/forms": "19.1.1",
    "@angular/material": "19.1.0",
    "@angular/platform-browser": "19.1.1",
    "@angular/platform-browser-dynamic": "19.1.1",
    "@angular/router": "19.1.1",
    "@angular/youtube-player": "19.1.0",
    "@auth0/angular-jwt": "5.2.0",
    "@material/material-color-utilities": "0.3.0",
    "@ng-maps/core": "7.0.0",
    "@ng-maps/google": "7.0.0",
    "@ng-maps/marker-clusterer": "7.0.0",
    "@ngbracket/ngx-layout": "19.0.0",
    "@ngx-formly/core": "7.0.0-alpha.1",
    "@ngx-formly/material": "7.0.0-alpha.1",
    "@yellowspot/ng-truncate": "2.0.2",
    "core-js": "3.40.0",
    "flat": "6.0.1",
    "geolib": "3.3.4",
    "lodash-es": "^4.17.21",
    "ng2-pdfjs-viewer": "18.0.0",
    "ngx-device-detector": "9.0.0",
    "ngx-markdown": "19.0.0",
    "rfdc": "1.4.1",
    "rxjs": "7.8.1",
    "tslib": "2.8.1",
    "zone.js": "0.15.0"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "19.0.0",
    "@angular-builders/jest": "19.0.0",
    "@angular-eslint/builder": "19.0.2",
    "@angular-eslint/eslint-plugin": "19.0.2",
    "@angular-eslint/eslint-plugin-template": "19.0.2",
    "@angular-eslint/schematics": "19.0.2",
    "@angular-eslint/template-parser": "19.0.2",
    "@angular/build": "19.1.1",
    "@angular/cli": "19.1.1",
    "@angular/compiler-cli": "19.1.1",
    "@angular/language-service": "19.1.1",
    "@babel/plugin-transform-modules-commonjs": "7.26.3",
    "@babel/preset-env": "7.26.0",
    "@cypress/schematic": "3.0.0",
    "@eslint/js": "9.18.0",
    "@faker-js/faker": "9.4.0",
    "@jest/globals": "29.7.0",
    "@peculiar/webcrypto": "1.5.0",
    "@types/google.maps": "3.58.1",
    "@types/jest": "29.5.14",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "22.10.7",
    "@types/youtube": "0.1.0",
    "@typescript-eslint/eslint-plugin": "8.20.0",
    "@typescript-eslint/parser": "8.20.0",
    "angular-eslint": "19.0.2",
    "autoprefixer": "10.4.20",
    "babel-jest": "29.7.0",
    "cypress": "14.0.0",
    "cypress-fail-fast": "7.1.1",
    "cypress-network-idle": "1.15.0",
    "cypress-terminal-report": "7.1.0",
    "dotenv-webpack": "8.1.0",
    "eslint": "9.18.0",
    "eslint-plugin-chai-friendly": "1.0.1",
    "eslint-plugin-cypress": "4.1.0",
    "eslint-plugin-jest": "28.11.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-esm-transformer-2": "1.0.0",
    "jest-preset-angular": "14.5.0",
    "ng-mocks": "14.13.4",
    "postcss": "8.5.1",
    "prettier": "3.4.2",
    "prettier-plugin-organize-imports": "4.1.0",
    "rxjs-compat": "6.6.7",
    "stylelint": "^16.14.1",
    "stylelint-config-standard": "^37.0.0",
    "stylelint-config-standard-scss": "14.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "type-fest": "4.37.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0",
    "webpack": "5.97.1",
    "webpack-bundle-analyzer": "4.10.2"
  },
  "overrides": {
    "ng2-pdfjs-viewer": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core",
      "@angular/compiler-cli": "$@angular/compiler-cli",
      "typescript": "$typescript",
      "ng-packagr": " ^19.0.0"
    },
    "@ng-maps/core": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core",
      "@angular/platform-browser-dynamic": "$@angular/platform-browser-dynamic",
      "zone.js": "$zone.js"
    },
    "@ng-maps/google": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core",
      "@angular/platform-browser-dynamic": "$@angular/platform-browser-dynamic",
      "zone.js": "$zone.js"
    },
    "@ng-maps/marker-clusterer": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core",
      "@angular/platform-browser-dynamic": "$@angular/platform-browser-dynamic",
      "zone.js": "$zone.js"
    },
    "ajv": "8.17.1",
    "tough-cookie": "5.1.2",
    "whatwg-url": "14.1.1"
  }
}

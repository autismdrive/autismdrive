{
  "name": "autismdrive",
  "version": "1.18.0",
  "scripts": {
    "backend-reset": "cd .. && ./reset-backend.sh --skip_update && cd ..",
    "build": "ng build",
    "bundle-report": "webpack-bundle-analyzer dist/star-drive/stats-es5.json",
    "cypress:ci": "cypress run --headless --browser chrome --config viewportWidth=1440,viewportHeight=900",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "e2e": "ng e2e",
    "format": "prettier --write .",
    "lint": "tsc --noEmit && eslint eslint.config.mjs",
    "lint-and-fix": "tsc --noEmit && eslint eslint.config.mjs --fix",
    "ng": "ng",
    "start": "ng serve",
    "start_production": "ng serve --configuration=production",
    "start_staging": "ng serve --configuration=staging",
    "start_dev": "ng serve --configuration=dev",
    "start_ci": "ng serve --configuration=ci",
    "start_proxy": "ng serve --port 4200 --host proxy.debug --configuration=proxy",
    "start_ssl": "ng serve --ssl true",
    "test": "ng test frontend",
    "test:watch": "jest -o --watch --config ./jest.config.js",
    "test_headless": "jest --coverage --config ./jest.config.js"
  },
  "engines": {
    "node": "22.3.0"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "18.2.9",
    "@angular/cdk": "18.2.10",
    "@angular/common": "18.2.9",
    "@angular/compiler": "18.2.9",
    "@angular/core": "18.2.9",
    "@angular/forms": "18.2.9",
    "@angular/material": "18.2.10",
    "@angular/platform-browser": "18.2.9",
    "@angular/platform-browser-dynamic": "18.2.9",
    "@angular/router": "18.2.9",
    "@angular/youtube-player": "18.2.10",
    "@auth0/angular-jwt": "5.2.0",
    "@ng-maps/core": "6.0.1",
    "@ng-maps/google": "6.0.0",
    "@ng-maps/marker-clusterer": "6.0.0",
    "@ngbracket/ngx-layout": "18.0.0",
    "@ngx-formly/core": "6.3.10",
    "@ngx-formly/material": "6.3.10",
    "@yellowspot/ng-truncate": "2.0.2",
    "core-js": "3.38.1",
    "flat": "6.0.1",
    "geolib": "3.3.4",
    "ng2-pdfjs-viewer": "18.0.0",
    "ngx-device-detector": "8.0.0",
    "ngx-markdown": "18.1.0",
    "rfdc": "1.4.1",
    "rxjs": "7.8.1",
    "tslib": "2.8.0",
    "zone.js": "0.14.10"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "18.0.0",
    "@angular-builders/jest": "18.0.0",
    "@angular-eslint/builder": "18.4.0",
    "@angular-eslint/eslint-plugin": "18.4.0",
    "@angular-eslint/eslint-plugin-template": "18.4.0",
    "@angular-eslint/schematics": "18.4.0",
    "@angular-eslint/template-parser": "18.4.0",
    "@angular/build": "^18.2.10",
    "@angular/cli": "18.2.10",
    "@angular/compiler-cli": "18.2.9",
    "@angular/language-service": "18.2.9",
    "@babel/plugin-transform-modules-commonjs": "7.25.9",
    "@babel/preset-env": "7.26.0",
    "@cypress/schematic": "2.5.2",
    "@eslint/js": "9.13.0",
    "@faker-js/faker": "9.1.0",
    "@peculiar/webcrypto": "1.5.0",
    "@types/google.maps": "3.53.6",
    "@types/cypress": "1.1.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.8.1",
    "@types/youtube": "0.1.0",
    "@typescript-eslint/eslint-plugin": "8.11.0",
    "@typescript-eslint/parser": "8.11.0",
    "angular-eslint": "18.4.0",
    "autoprefixer": "10.4.20",
    "babel-jest": "29.7.0",
    "cypress": "13.15.1",
    "cypress-fail-fast": "7.1.1",
    "cypress-network-idle": "1.14.2",
    "cypress-terminal-report": "7.0.4",
    "dotenv-webpack": "8.1.0",
    "eslint": "9.13.0",
    "eslint-plugin-chai-friendly": "1.0.1",
    "eslint-plugin-cypress": "4.0.0",
    "eslint-plugin-jest": "28.8.3",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-esm-transformer-2": "1.0.0",
    "jest-preset-angular": "14.2.4",
    "ng-mocks": "14.13.1",
    "postcss": "8.4.47",
    "prettier": "3.3.3",
    "prettier-plugin-organize-imports": "4.1.0",
    "rxjs-compat": "6.6.7",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.5.4",
    "typescript-eslint": "8.11.0",
    "webpack": "5.95.0",
    "webpack-bundle-analyzer": "4.10.2"
  },
  "overrides": {
    "@ng-maps/core": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core",
      "@angular/platform-browser-dynamic": "$@angular/platform-browser-dynamic"
    },
    "@ng-maps/google": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core",
      "@angular/platform-browser-dynamic": "$@angular/platform-browser-dynamic"
    },
    "@ng-maps/marker-clusterer": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core",
      "@angular/platform-browser-dynamic": "$@angular/platform-browser-dynamic"
    }
  }
}
